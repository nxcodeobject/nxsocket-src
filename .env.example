# Contoh environment NxSocket
# Salin ke .env lokal jika perlu (jangan commit secret)

NXSOCKET_PORT=7080
NXSOCKET_HOST=0.0.0.0
NXSOCKET_PATH=/v1
NXSOCKET_DATA_DIR=./data
NXSOCKET_ADAPTER=sqlite

# HTTPS self-signed (disarankan untuk mic HP)
# NXSOCKET_HTTPS=1

# Rate limit: max pesan / jendela (ms)
NXSOCKET_RATE_LIMIT_MAX=60
NXSOCKET_RATE_LIMIT_WINDOW_MS=10000

# Heartbeat
NXSOCKET_HEARTBEAT_INTERVAL_MS=15000
NXSOCKET_HEARTBEAT_TIMEOUT_MS=45000

# Firebase (hanya jika NXSOCKET_ADAPTER=firebase)
# NXSOCKET_FIREBASE_CREDENTIALS=./serviceAccount.json
# NXSOCKET_FIREBASE_DATABASE_URL=

# AI streaming (OpenAI-compatible)
# Default: baca AUTO_MODELS dari %APPDATA%/nxcode/settings.json (rotasi apiKeys seperti nxcode)
# Override:
# NXSOCKET_AI_URL=https://openrouter.ai/api/v1
# NXSOCKET_AI_MODEL=openrouter/free
# NXSOCKET_AI_API_KEY=sk-or-v1-...
# NXSOCKET_AI_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb
# NXSOCKET_NXCODE_SETTINGS=C:\Users\you\AppData\Roaming\nxcode\settings.json
# NXSOCKET_AI_REFERER=https://nxsocket.local
# NXSOCKET_AI_TITLE=NxSocket Demo4

# Remote AI Control (demo5) — folder kerja yang boleh dipakai agen
# NXSOCKET_WORKSPACE_ROOTS=D:\Framework,D:\IDE
# NXSOCKET_DEFAULT_CWD=D:\Framework\CLI\NxSocket
# NXSOCKET_CLAUDE_PATH=C:\Users\you\.local\bin\claude.exe
# NXSOCKET_CURSOR_AGENT_PATH=C:\Users\you\AppData\Local\cursor-agent\agent.cmd

# Cloudflare named tunnel (opsional) — setelah tunnel-named-setup.ps1
# Hostname contoh: nxsocket.domainanda.com

# WebRTC ICE / TURN (demo2 telepon, demo3 video) — penting beda jaringan / data seluler
# Opsi A — JSON penuh:
# NXSOCKET_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:turn.example:3478"],"username":"u","credential":"p"}]
# Opsi B — TURN terpisah (+ STUN Google otomatis):
# NXSOCKET_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# NXSOCKET_TURN_USERNAME=user
# NXSOCKET_TURN_CREDENTIAL=secret

# Web Push (VAPID) — notifikasi panggilan saat tab tertutup
# Default: auto-generate ke data/vapid-keys.json
# NXSOCKET_VAPID_PUBLIC_KEY=
# NXSOCKET_VAPID_PRIVATE_KEY=
# NXSOCKET_VAPID_SUBJECT=mailto:you@example.com

# LiveKit SFU (demo10) — lihat docs/sfu-livekit.md
# NXSOCKET_LIVEKIT_URL=ws://127.0.0.1:7880
# NXSOCKET_LIVEKIT_API_KEY=devkey
# NXSOCKET_LIVEKIT_API_SECRET=secret

# OTP (Remora register) — lihat docs/otp.md
# NXSOCKET_OTP_DEBUG=1
# NXSOCKET_OTP_WEBHOOK_URL=https://sms-provider.example/send
# NXSOCKET_OTP_WEBHOOK_SECRET=
